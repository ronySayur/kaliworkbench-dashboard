[Unit]
Description=KaliWorkbench backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kaliworkbench/backend
EnvironmentFile=-/etc/kaliworkbench/kaliworkbench.env
ExecStart=/opt/kaliworkbench/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2
User=kaliworkbench
Group=kaliworkbench
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/kaliworkbench/backend/data /var/lib/kaliworkbench

[Install]
WantedBy=multi-user.target
